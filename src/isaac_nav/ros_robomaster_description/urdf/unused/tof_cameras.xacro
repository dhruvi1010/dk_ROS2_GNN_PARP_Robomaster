<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">


<!-- Pico Flexx Front Plugin -->
 <gazebo reference="base_pico_front_link">
      <!-- Depth (IR) -->
      <sensor type="depth" name="PicoFlexxFront">
        <always_on>true</always_on>
        <update_rate>30</update_rate> 
        
        
        <camera>
          
          <horizontal_fov>${62.0 * DEG_TO_RAD}</horizontal_fov>
          <image>
            <format>R8G8B8</format>
            <width>224</width>
            <height>171</height>
          </image>
              </camera>

        <plugin name="Pcio_frame_controller_Front" filename="libgazebo_ros_openni_kinect.so">
          <alwaysOn>true</alwaysOn>
          <updateRate>30</updateRate>
          <cameraName>BasePicoFlexxFront</cameraName>
          <imageTopicName>ir/image_raw</imageTopicName>
          <cameraInfoTopicName>ir/camera_info</cameraInfoTopicName>
          <depthImageTopicName>depth/image_raw</depthImageTopicName>
          <depthImageCameraInfoTopicName>depth/camera_info</depthImageCameraInfoTopicName>
          <pointCloudTopicName>depth/points</pointCloudTopicName>
          <frameName>base_pico_front_depth_link</frameName>
          <pointCloudCutoff>0.05</pointCloudCutoff>
          <pointCloudCutoffMax>5</pointCloudCutoffMax>

          <rangeMax>4.0</rangeMax>
          <!-- Distortion parameters not supported in gazebo 1.9.* plugins -->
          <!--distortionK1>0.00000001</distortionK1>
          <distortionK2>0.00000001</distortionK2>
          <distortionK3>0.00000001</distortionK3>
          <distortionT1>0.00000001</distortionT1>
          <distortionT2>0.00000001</distortionT2-->
        </plugin>
      </sensor>
     
    </gazebo>



<!-- Pico Flexx Front Plugin -->
 <gazebo reference="pico_back_link">
      <!-- Depth (IR) -->
      <sensor type="depth" name="PicoFlexxBack">
        <always_on>true</always_on>
        <update_rate>30</update_rate> 
        <pose xyz="0 0 0" rpy="${-M_PI_2} 0 ${-M_PI_2} "/>
        
        <camera>
          
          <horizontal_fov>${62.0 * DEG_TO_RAD}</horizontal_fov>
          <image>
            <format>R8G8B8</format>
            <width>224</width>
            <height>171</height>
          </image>
              </camera>

        <plugin name="Pcio_frame_controller_Back" filename="libgazebo_ros_openni_kinect.so">
          <alwaysOn>true</alwaysOn>
          <pose xyz="0 0 0" rpy="${-M_PI_2} 0 ${-M_PI_2} "/>
          <updateRate>30</updateRate>
          <cameraName>PicoFlexxBack</cameraName>
          <imageTopicName>ir/image_raw</imageTopicName>
          <cameraInfoTopicName>ir/camera_info</cameraInfoTopicName>
          <depthImageTopicName>depth/image_raw</depthImageTopicName>
          <depthImageCameraInfoTopicName>depth/camera_info</depthImageCameraInfoTopicName>
          <pointCloudTopicName>depth/points</pointCloudTopicName>
          <frameName>pico_back_depth_link</frameName>
          <pointCloudCutoff>0.05</pointCloudCutoff>
          <pointCloudCutoffMax>5</pointCloudCutoffMax>

          <rangeMax>4.0</rangeMax>
          <!-- Distortion parameters not supported in gazebo 1.9.* plugins -->
          <!--distortionK1>0.00000001</distortionK1>
          <distortionK2>0.00000001</distortionK2>
          <distortionK3>0.00000001</distortionK3>
          <distortionT1>0.00000001</distortionT1>
          <distortionT2>0.00000001</distortionT2-->
        </plugin>
      </sensor>
     
    </gazebo>



</robot>
