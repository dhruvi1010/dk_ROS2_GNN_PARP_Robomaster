<?xml version="1.0"?>
<robot name="robomaster" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- Position of the up facing camera -->
    <xacro:property name="up_camera_Position_x" value="0.0" /> <!-- in m   -->
    <xacro:property name="up_camera_Position_y" value="0.0" /> <!-- in m   -->
    <xacro:property name="up_camera_Position_z" value="0.30" /> <!-- in m   -->
    <xacro:property name="up_camera_Orientation_r" value="0" /> <!-- in rad   -->
    <xacro:property name="up_camera_Orientation_p" value="-1.57" /> <!-- in rad  -->
    <xacro:property name="up_camera_Orientation_y" value="0" /> <!-- in rad   -->  <!-- Rotation around z Axis   -->

    <!-- Dimension Raspberry Pi Camera V2-->
    <xacro:property name="PiCamV2_dimension_x" value="0.001" />
    <xacro:property name="PiCamV2_dimension_y" value="0.020" />
    <xacro:property name="PiCamV2_dimension_z" value="0.024" />

    <!-- Up Camera link -->
    <link name="up_camera_link">
        <visual>
            <geometry>
                <box size="${PiCamV2_dimension_x} ${PiCamV2_dimension_x} ${PiCamV2_dimension_z}" />
            </geometry>
        </visual>
    </link>
    <joint name="up_camera_joint" type="fixed">
        <parent link="base_link" />
        <child link="up_camera_link" />
        <origin
            xyz="${up_camera_Position_x} ${up_camera_Position_y} ${up_camera_Position_z}"
            rpy="${up_camera_Orientation_r} ${up_camera_Orientation_p} ${up_camera_Orientation_y}" />
    </joint>
    
  <!-- In computer vision the z-axis points into the picture plain (so to the front of the camera),
   in ros (REP-103) the x-axis should point to the front, since gazebo plugins use this convention
   we need "gazebo" frames for the cameras, where the x axis points to the front -->

    <link name="up_camera_gazebo_link"/>
    <joint name="up_camera_gazebo_joint" type="fixed">
        <parent link="base_link" />
        <child link="up_camera_gazebo_link" />
        <origin xyz="${up_camera_Position_x} ${up_camera_Position_y} ${up_camera_Position_z}"
            rpy="${up_camera_Orientation_r} ${up_camera_Orientation_p} ${up_camera_Orientation_y}" />
    </joint>

    <!-- Gazebo Plugin -->
    <gazebo reference="up_camera_gazebo_link">
        <sensor type="camera" name="camera_up">
          <update_rate>30.0</update_rate>
          <camera name="head">
            <horizontal_fov>${62.0 * DEG_TO_RAD}</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.02</near>
              <far>300</far>
            </clip>
            <noise>
              <type>gaussian</type>
              <!-- Noise is sampled independently per pixel on each frame.
                   That pixel's noise value is added to each of its color
                   channels, which at that point lie in the range [0,1]. -->
              <mean>0.0</mean>
              <stddev>0.007</stddev>
            </noise>
          </camera>
          <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
            <always_on>true</always_on>
            <update_rate>0.0</update_rate>
            <camera_name>cameraUp</camera_name>
            <frame_name>up_camera_link</frame_name>
            <hack_baseline>0.07</hack_baseline>
          </plugin>
        </sensor>
      </gazebo>

</robot>